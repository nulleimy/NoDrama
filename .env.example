# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Admin
# Comma-separated allowlist for server-side admin pages.
ADMIN_EMAILS=
ADMIN_ANALYTICS_TOKEN=

# NoDrama runtime flags
# Production-safe defaults are all false unless explicitly set to true.
NODRAMA_TEST_MODE=false
NODRAMA_DISABLE_FREE_LIMIT=false
NODRAMA_ENABLE_HISTORY=false
NODRAMA_ENABLE_EVENT_LOGGING=false
NODRAMA_ENABLE_CLOUD_HISTORY=false
NODRAMA_ENABLE_PHRASE_REALIZER=false
NODRAMA_ENABLE_DEV_CREDIT_GRANTS=false

# Hybrid ethical generation
# Default stays deterministic. Set hybrid explicitly to send the user's situation
# to the configured external model provider. Provider failures fall back to phrase.
NODRAMA_GENERATION_MODE=phrase
NODRAMA_OPENAI_MODEL=gpt-5.6
NODRAMA_OPENAI_TIMEOUT_MS=12000

# OpenAI
# Server-side secret only. Never expose as NEXT_PUBLIC_* or commit a real value.
OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_POWER_MONTHLY=
STRIPE_PRICE_SOS_PACK=
STRIPE_PRICE_MINI_PACK=
STRIPE_PRICE_KLID_PACK=

# Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend
RESEND_API_KEY=

NODRAMA_ALLOW_DEV_CREDIT_GRANTS=false

# Persistence backend used by the local recovery/test profile.
NODRAMA_PERSISTENCE_BACKEND=local_json
